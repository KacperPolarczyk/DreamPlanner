# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfplan
**/tfplan
**/crash.log
**/crash.*.log

# Local configuration and credentials (templates may be committed)
.env
.env.*
!.env.example
.pgpass
.pg_service.conf

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

# Local Markdown documentation
/*.md
!/README.md
!/NEXT_STEPS.md

/backend/*.md
!/backend/README.md
!/backend/API_WORKFLOW.md

# Local backend reference directories
/backend/.*-reference/
