{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "name": "description",
      "content": {
        "json": "# DreamPlanner — monitoring\nDane z ostatniej godziny. Odśwież widok po kilku minutach, jeśli konfiguracja została właśnie włączona. CPU i RAM planu są współdzielone przez frontend, backend i zadania migracji. Brak danych nie oznacza zera ani poprawnego działania."
      }
    },
    {
      "type": 9,
      "name": "hosting-plan",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a57c5d52-8aeb-4b7b-8d65-8a82c29aa984",
            "version": "KqlParameterItem/1.0",
            "name": "HostingPlan",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "isHiddenWhenLocked": true,
            "typeSettings": {
              "resourceTypeFilter": {
                "microsoft.web/serverfarms": true
              }
            },
            "value": [
              "${hosting_plan_id}"
            ]
          }
        ]
      }
    },
    {
      "type": 3,
      "name": "chart-0",
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppServiceHTTPLogs\n| where TimeGenerated > ago(1h)\n| where _ResourceId has \"/app-dreamplanner-backend-77076\"\n| extend StatusClass = strcat(tostring(toint(ScStatus / 100)), \"xx\")\n| summarize Requests=count() by bin(TimeGenerated, 1m), StatusClass",
        "size": 0,
        "title": "HTTP — odpowiedzi API według klas statusu",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart",
        "timeContext": {
          "durationMs": 3600000
        },
        "crossComponentResources": [
          "${workspace_id}"
        ]
      }
    },
    {
      "type": 3,
      "name": "chart-1",
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppServiceHTTPLogs\n| where TimeGenerated > ago(1h)\n| where _ResourceId has \"/app-dreamplanner-backend-77076\"\n| summarize ResponseTimeMs=avg(TimeTaken) by bin(TimeGenerated, 1m)",
        "size": 0,
        "title": "API — średni czas odpowiedzi (ms)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart",
        "timeContext": {
          "durationMs": 3600000
        },
        "crossComponentResources": [
          "${workspace_id}"
        ]
      }
    },
    {
      "type": 10,
      "name": "chart-2",
      "content": {
        "version": "MetricsItem/1.0",
        "chartId": "chart-2-dreamplanner",
        "title": "Plan App Service — CPU (%)",
        "size": 0,
        "timeContext": {
          "durationMs": 3600000
        },
        "resourceType": "microsoft.web/serverfarms",
        "resourceParameter": "HostingPlan",
        "metrics": [
          {
            "namespace": "microsoft.web/serverfarms",
            "metric": "microsoft.web/serverfarms--CpuPercentage",
            "aggregation": 4,
            "chartType": 2
          }
        ]
      }
    },
    {
      "type": 10,
      "name": "chart-3",
      "content": {
        "version": "MetricsItem/1.0",
        "chartId": "chart-3-dreamplanner",
        "title": "Plan App Service — RAM (%)",
        "size": 0,
        "timeContext": {
          "durationMs": 3600000
        },
        "resourceType": "microsoft.web/serverfarms",
        "resourceParameter": "HostingPlan",
        "metrics": [
          {
            "namespace": "microsoft.web/serverfarms",
            "metric": "microsoft.web/serverfarms--MemoryPercentage",
            "aggregation": 4,
            "chartType": 2
          }
        ]
      }
    },
    {
      "type": 3,
      "name": "chart-4",
      "content": {
        "version": "KqlItem/1.0",
        "query": "AzureMetrics\n| where TimeGenerated > ago(1h)\n| where ResourceProvider =~ \"MICROSOFT.DBFORPOSTGRESQL\" and MetricName in (\"cpu_percent\", \"memory_percent\")\n| summarize Value=avg(Average) by bin(TimeGenerated, 1m), MetricName",
        "size": 0,
        "title": "PostgreSQL — CPU i RAM (%)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart",
        "timeContext": {
          "durationMs": 3600000
        },
        "crossComponentResources": [
          "${workspace_id}"
        ]
      }
    }
  ],
  "isLocked": false,
  "fallbackResourceIds": [
    "${workspace_id}"
  ]
}
