# Copy to database/.env and fill in locally. Never commit the real value.
# PostgreSQL URI for database tooling; the backend driver is configured separately.
# Percent-encode special characters in the URI username and password.
# postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?sslmode=verify-full&sslrootcert=/path/to/trusted-ca-bundle.pem
DATABASE_URL=
