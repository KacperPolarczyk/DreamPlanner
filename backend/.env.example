APP_NAME="DreamPlanner API"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
# Local Docker Compose initialization. Replace every password in backend/.env.
POSTGRES_DB=dreamplanner
POSTGRES_USER=dreamplanner_admin
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-admin-password
POSTGRES_APP_PASSWORD=replace-with-local-app-password
POSTGRES_MIGRATION_PASSWORD=replace-with-local-migration-password

# Backend runs directly in WSL; use the host-mapped port and matching passwords.
DATABASE_URL=postgresql+psycopg://dreamplanner_app:replace-with-local-app-password@127.0.0.1:5432/dreamplanner
MIGRATION_DATABASE_URL=postgresql+psycopg://dreamplanner_migration:replace-with-local-migration-password@127.0.0.1:5432/dreamplanner
