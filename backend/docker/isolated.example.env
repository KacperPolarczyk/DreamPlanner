# Example values only. Copy to ../.env.isolated and replace every password/key.
# Use URL-safe password characters because Compose puts these values in URLs.
ISOLATED_ADMIN_PASSWORD=replace-with-unique-local-admin-password
ISOLATED_APP_PASSWORD=replace-with-unique-local-app-password
ISOLATED_MIGRATION_PASSWORD=replace-with-unique-local-migration-password
ISOLATED_TEST_APP_PASSWORD=replace-with-unique-local-test-app-password
ISOLATED_TEST_MIGRATION_PASSWORD=replace-with-unique-local-test-migration-password
ISOLATED_JWT_SIGNING_KEY_BASE64=replace-with-base64-of-at-least-32-random-bytes
ISOLATED_POSTGRES_HOST_PORT=55432
ISOLATED_APP_HOST_PORT=8001

# The three host URLs are used only by explicit migrations and tests.
MIGRATION_DATABASE_URL=postgresql+psycopg://dreamplanner_isolated_migration:replace-with-unique-local-migration-password@127.0.0.1:55432/dreamplanner_stage1632b
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://dreamplanner_migration:replace-with-unique-local-test-migration-password@127.0.0.1:55432/dreamplanner_test_publication_races_134
TEST_DATABASE_URL=postgresql+psycopg://dreamplanner_app:replace-with-unique-local-test-app-password@127.0.0.1:55432/dreamplanner_test_publication_races_134
